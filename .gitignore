# 环境与密钥
.env
.env.*
!.env.example

# 依赖与构建产物
node_modules/
dist/
build/
*.tsbuildinfo
.nocobase/

# 例外：h5/dist 是 nginx 容器的 bind mount 宿主目录，必须真实存在于仓库中。
# 若不存在，docker 会「静默创建一个 root 所有的空目录」挂进去，报错信息完全
# 对不上（表现为 /h5/ 404 而非挂载错误），scripts/verify-config.mjs 也会失败。
# 因此：只保留 .gitkeep 让目录存在，dist 下的**全部内容都是构建产物**。
#
# ⚠️ Phase 3 修正（原规则曾对 index.html 开例外，那是错的）：
#   dist/index.html 不是"静态占位页"，它是 **Vite 的构建输出**，
#   里面写死了 `assets/index-<hash>.js` 这种带内容哈希的文件名。
#   给它开例外会出现一个很难看的状态：index.html 入库、它引用的 assets 不入库，
#   于是别人 clone 下来直接部署，得到的是一个**引用缺失 JS 的白屏首页** ——
#   比"什么都没有"更难排查（页面能开、控制台 404）。
#   正确做法：整个 dist 不入库；部署前必须 `cd h5 && npm ci && npm run build`（见 README）。
#   .gitkeep 由 h5/public/.gitkeep 在每次构建时自动复制进 dist（publicDir 语义）。
!h5/dist/
/h5/dist/*
!/h5/dist/.gitkeep

# 上传与备份（禁止入库）
backups/*
!backups/.gitkeep
uploads-private/
storage/uploads/

# ---------------------------------------------------------------- NocoBase 运行时数据
# ⚠️ 这一段是**安全修补**，不是整理洁癖。
#
# `storage/apps/main/aes_key.dat` 是 NocoBase 生成的 **AES 主密钥**（32 字节），
# 用于加密库内敏感字段。它**不出现在 `.env` 里**，因此"用 .env 的值反查文件"
# 这种密钥扫描**查不出它** —— 原 .gitignore 没有任何规则能匹配它，
# 结果它会安安静静地被推上远程仓库。任何拿到它 + 一份数据库备份的人，
# 都能解开加密列。这是必须堵死的一条。
#
# `storage/.license/instance-id` 是实例签名（base64），属实例身份信息。
# `storage/nocobase.conf` 是 NocoBase 运行时**自动生成**的 nginx 片段，
# 与本项目自己维护的 `nginx/` 无关，入库会产生"这份配置从哪来的"的误导。
# `storage/plugins/` 是 `scripts/build-plugin.mjs` 的产物目录（可重建）。
storage/apps/
storage/.license/
storage/nocobase.conf
storage/plugins/
storage/logs/

# AI 工作记录（内部验收口径、排障过程、决策讨论）——不属于项目源码，不入库
.workbuddy/

# 验收脚本的临时构建产物（`verify-phase3-h5.mjs` 用 esbuild 把 h5/src/api/public.ts
# 打成 ESM 后真跑，产物落在这里）。它是**每次运行都能重建**的中间物，
# 且文件名/hash 会随源码变 —— 入库只会制造无意义的 diff。
# 脚本自己会 `mkdirSync(..., { recursive: true })`，所以忽略它不影响任何流程。
.tmp-verify/

# P5 排障期的工具工作目录（fixture 生成脚本、mock 发件箱 JSON 等）：
# 全部可重建的中间物，且 `outbox.json` 之类含**明文 Token**（仅 mock 环境，仍不入库）。
.tmp-media/

# DEV-84 排障期的工具工作目录（orientation 夹具生成脚本、实拍形态验片图等）：
# 全部可重建；其中 `phone-shot/` 是验片产物（对照图会单独落 docs 引用的路径）。
.tmp-orient/

# 破坏性排障探针（含硬编码的真库操作，门闩 SVC_PROBE_ALLOW_DESTRUCTIVE=1）。
# 取证结论已完整落在 docs/DEVIATIONS.md（DEV-27），探针本身无需随源码分发 ——
# 否则别人 clone 后误设环境变量就会破坏他们自己的库。
#
# ⚠️ `.probe/` 只匹配**目录**，匹配不到根目录下的 `.probe-xxx.mjs` **文件**。
#    本轮（2026-09-22）就是被这个疏漏坑到：62 个临时探针/输出文件在 `git status`
#    里全是 `??`，差一点跟着提交进公开仓库。两条都要写，且文件通配符要带 `*`。
.probe/
.probe-*
.probe-*.*

# 一次性排障输出（前哨/基线/反向验证的 stdout 落盘）
.preflight*.txt
.baseline*.txt
.probe-*.out.txt
.probe-*.stdout.txt

# 临时 SQL（反向验证时手搓的查询/删除语句，含真实表名与角色名）
.q*.sql

# 运行时数据卷（本地调试用）
data/
pgdata/

# 日志
*.log
logs/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 测试覆盖
coverage/
