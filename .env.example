# =============================================================================
#  家电门店售后服务平台 — 环境变量样例
# -----------------------------------------------------------------------------
#  用法：  cp .env.example .env  然后替换所有 CHANGE_ME 值
#  安全：  .env 已列入 .gitignore，禁止提交到 Git；密钥绝不可写入前端代码
#  生成：  node scripts/gen-secret.mjs        （生成 APP_KEY / 各类密钥）
# =============================================================================

# =========================== 1. 应用基础 =====================================
# 应用加密密钥：用于加密用户 token 等敏感信息。一旦修改，所有已签发 token 失效。
APP_KEY=CHANGE_ME__APP_KEY_64_RANDOM_CHARS

# 时区：影响工单号日期、SLA 判定、报表口径
TZ=Asia/Shanghai

# 应用语言
APP_LANGUAGE=zh-CN

# NocoBase 容器内监听端口（不对宿主机暴露，仅供 nginx 容器内网访问）
APP_PORT=13000

# 对外访问基址：用于拼接短信中的师傅作业链接与客户评价链接
# 必须与 Nginx 暴露的域名一致（含协议），末尾不加斜杠
PUBLIC_BASE_URL=http://localhost

# =========================== 2. PostgreSQL ===================================
DB_DIALECT=postgres
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=service_ticket
DB_USER=svc_app
DB_PASSWORD=CHANGE_ME__DB_PASSWORD

# postgres 容器首次初始化时使用，必须与上面 DB_* 保持一致
POSTGRES_USER=svc_app
POSTGRES_DB=service_ticket
POSTGRES_PASSWORD=CHANGE_ME__DB_PASSWORD

# =========================== 3. NocoBase 插件加载 ============================
# 说明（来自 NocoBase 2.2.x 源码 plugin-manager / @nocobase/utils）：
#   1) storage/plugins 目录会被自动扫描，用于存放「已编译」的独立插件；
#   2) APPEND_PRESET_BUILT_IN_PLUGINS 列出的插件会被自动安装 + 自动启用；
#   3) 包名必须命中 PLUGIN_PACKAGE_PREFIX 前缀白名单，否则启动直接抛错；
#   4) 插件需能被 node 以「包名」解析到（require.resolve），故 compose 把插件
#      同时挂载到 storage/plugins 与 node_modules 两处（见 docker-compose.yml）。
APPEND_PRESET_BUILT_IN_PLUGINS=@local/service-ticket

# 包名前缀白名单。必须包含 NocoBase 默认的两项，否则核心插件会全部加载失败；
# 末尾追加 @local/ 以放行本项目的自研插件。
PLUGIN_PACKAGE_PREFIX=@nocobase/plugin-,@nocobase/preset-,@local/

# 容器内路径（官方镜像 WORKDIR=/app/nocobase），一般无需修改
NODE_MODULES_PATH=/app/nocobase/node_modules
STORAGE_PATH=/app/nocobase/storage
PLUGIN_STORAGE_PATH=/app/nocobase/storage/plugins

# 关闭「提取前端静态资源并生成代理配置」：本项目自维护 Nginx 配置
# （nginx/conf.d/service.conf），NocoBase 后台前端资源由 nginx 反代到应用进程。
# 若后续想让 nginx 直接托管后台静态资源以提升性能，改为 true 并参照
# docs/DEVIATIONS.md 中的说明调整 nginx 配置。
NOCOBASE_EXTRACT_CLIENT_ASSETS=false

# =========================== 4. 业务签名密钥 =================================
# 用于照片受控读取的短时签名 URL（HMAC），以及匿名接口的 IP 加盐哈希
# 更换后已签发的照片预览链接立即失效（可接受，重新访问会重新签发）
SIGN_SECRET=CHANGE_ME__SIGN_SECRET_64_RANDOM_CHARS
# 照片签名 URL 有效期（秒）
SIGN_URL_TTL_SECONDS=600

# =========================== 5. 文件上传限制 =================================
# 上传根目录（容器内路径，会落到 ./storage 卷）
UPLOAD_PRIVATE_DIR=/app/nocobase/storage/uploads-private
# 单张照片上限（MB）
UPLOAD_MAX_SIZE_MB=5
# 单次上门最多照片数
UPLOAD_MAX_COUNT=6
# 服务端重编码后长边像素上限（同时剥离 EXIF/GPS）
UPLOAD_MAX_EDGE_PX=1600
# 服务端重编码质量
UPLOAD_JPEG_QUALITY=82

# =========================== 6. 短信适配层 ===================================
# 可选：mock | aliyun | tencent
# 开发与联调期使用 mock（短信内容写入 SmsLog 并输出到应用日志，不真实发送）
SMS_PROVIDER=mock
# 失败自动重试次数（文档要求最多 1 次）
SMS_RETRY_COUNT=1
# 短信服务商就绪标志：设置为 false 时，短信任务会被跳过，SmsLog 记为 rejected
SMS_ENABLED=false

# ---- 阿里云短信（SMS_PROVIDER=aliyun 时必填）----
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_REGION_ID=cn-hangzhou
# 模板 CODE（模板变量必须与服务商审核通过的模板一致）
ALIYUN_SMS_TPL_DISPATCH_CUSTOMER=
ALIYUN_SMS_TPL_TECHNICIAN_TASK=
ALIYUN_SMS_TPL_DISPATCH_UPDATE=
ALIYUN_SMS_TPL_REVIEW_INVITE=

# ---- 腾讯云短信（预留，本版本未实现）----
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TPL_DISPATCH_CUSTOMER=
TENCENT_SMS_TPL_TECHNICIAN_TASK=
TENCENT_SMS_TPL_DISPATCH_UPDATE=
TENCENT_SMS_TPL_REVIEW_INVITE=

# ---- mock 短信校验键（回调验签测试用）----
MOCK_SMS_CALLBACK_SECRET=CHANGE_ME__MOCK_CALLBACK_SECRET

# =========================== 7. 业务参数默认值 ===============================
# 说明：这些值会作为「首次初始化」写入 system_settings 表的种子值；
#       上线后调整参数请在「总部后台 → 参数配置」中修改，不要改这里。
#       这里保留是为了让首次部署即可运行，无需先手工配置。
SVC_DEFAULT_FEEDBACK_LOW_SCORE_THRESHOLD=2
SVC_DEFAULT_FEEDBACK_WAIT_DAYS=7
SVC_DEFAULT_FEEDBACK_TOKEN_EXPIRE_DAYS=15
SVC_DEFAULT_TECHNICIAN_TOKEN_EXPIRE_HOURS=72
SVC_DEFAULT_SLA_ACCEPT_MINUTES=120
SVC_DEFAULT_SLA_APPOINTMENT_OVERDUE_GRACE_MINUTES=120
SVC_DEFAULT_SLA_STORE_CONFIRM_HOURS=48
SVC_DEFAULT_SECURITY_IP_MINUTE_LIMIT=30
SVC_DEFAULT_SECURITY_TICKET_PHONE_DAILY_LIMIT=5
SVC_DEFAULT_SECURITY_DUPLICATE_WINDOW_MINUTES=10
SVC_DEFAULT_PRIVACY_RETENTION_MONTHS=24

# ---- ACL 字段白名单自动对齐（Phase 2.1 整改项 4）----------------------------
# 四个业务角色在原生只读接口上的字段白名单由代码单一事实来源决定。
#   =1（默认）启动时把与期望白名单不一致的行对齐回期望值；
#   =0 关闭该对齐，保留库里的手工取值。
# ⚠️ 无论本开关取值，fields=null（整行下发、泄露 token 哈希）与 fields=[]
#    （空壳、业务列全丢）都会被纠正 —— 那是漏洞，不是配置。
SVC_ACL_FIELDS_AUTOFIX=1

# =========================== 8. 宿主机端口映射 ===============================
# Nginx 对外端口。本地验证用 80；若 80 被占用可改为 8080（此时 PUBLIC_BASE_URL 要带端口）
NGINX_HTTP_PORT=80
# HTTPS 端口（配置证书后启用 nginx/conf.d/ssl.conf）
NGINX_HTTPS_PORT=443
# 应用调试端口：仅绑定宿主机回环，不对局域网/公网暴露；不需要时删除该映射
APP_DEBUG_PORT=13000

# =========================== 9. 备份 =========================================
BACKUP_RETENTION_DAYS=30
BACKUP_PASSPHRASE=CHANGE_ME__BACKUP_ENCRYPTION_PASSPHRASE
